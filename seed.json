      "name": "Single Arm Dumbbell Row",
      "muscleGroup": "Back",
      "equipment": "Dumbbell",
      "category": "Compound",
      "instructions": "Brace on bench, neutral spine. Row dumbbell to hip, keeping elbow close to torso."
    },
    {
      "id": "ex-49",
      "name": "Sumo Deadlift",
      "muscleGroup": "Back",
      "equipment": "Barbell",
      "category": "Compound",
      "instructions": "Wide stance, toes out. Grip inside knees, drive hips through at lockout."
    },
    {
      "id": "ex-50",
      "name": "Chest Supported Row",
