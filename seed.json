      "equipment": "Machine",
      "category": "Isolation",
      "instructions": "Sit with back flat. Bring handles together in front of chest, pause and squeeze."
    },
    {
      "id": "ex-18",
      "name": "Chest Dip",
      "muscleGroup": "Chest",
      "equipment": "Bodyweight",
      "category": "Compound",
      "instructions": "Lean torso forward 30°, lower until arms hit 90°. Drive up, squeezing chest at top."
    },
    {
      "id": "ex-7",
      "name": "Barbell Conventional Deadlift",
      "muscleGroup": "Back",
      "equipment": "Barbell",
      "category": "Compound",
      "instructions": "Mid-foot under bar, grip shoulder-width, flat back. Drive floor away and lock hips."
    },
    {
      "id": "ex-8",
      "name": "Lat Pulldown",
      "muscleGroup": "Back",
      "equipment": "Cable",
      "category": "Compound",
      "instructions": "Wide overhand grip. Pull bar to upper chest, arch upper back and squeeze lats."
    },
    {
      "id": "ex-9",
      "name": "Seated Cable Row",
      "muscleGroup": "Back",
      "equipment": "Cable",
      "category": "Compound",
      "instructions": "Neutral spine, pull handle to lower sternum, driving elbows backward."
    },
    {
      "id": "ex-19",
      "name": "Barbell Bent-Over Row",
      "muscleGroup": "Back",
      "equipment": "Barbell",
      "category": "Compound",
      "instructions": "Hinge to 45°, overhand grip. Pull bar to lower ribcage, squeeze shoulder blades."
    },
    {
      "id": "ex-20",
      "name": "T-Bar Row",
      "muscleGroup": "Back",
      "equipment": "Barbell",
      "category": "Compound",
      "instructions": "Straddle bar, chest on pad. Pull handles to chest, keeping elbows close to body."
    },
    {
      "id": "ex-21",
      "name": "Pull-Up / Chin-Up",
      "muscleGroup": "Back",
      "equipment": "Bodyweight",
      "category": "Compound",
      "instructions": "Dead hang, full grip. Pull chest to bar driving elbows down and back. Lower controlled."
    },
    {
