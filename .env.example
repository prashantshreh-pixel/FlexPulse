# Django Core Security
DJANGO_SECRET_KEY=replace-with-a-64-char-random-secret-key
DJANGO_DEBUG=False
DJANGO_USE_HTTPS=False
DJANGO_ALLOWED_HOSTS=flexpulse.app,www.flexpulse.app,localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/

# CORS & CSRF Origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://flexpulse.app,https://www.flexpulse.app,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://flexpulse.app,https://www.flexpulse.app,http://localhost:3000,http://127.0.0.1:3000

# Optional Seeding Credentials (only used by backend/seed.py when explicitly set)
FLEXPULSE_ADMIN_PASSWORD=
FLEXPULSE_TEST_PASSWORD=

# Frontend Custom Domain
VITE_APP_DOMAIN=flexpulse.app
